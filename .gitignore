*.db
*.db-wal
*.db-shm
*.log
bridge.token
portable.txt

# Signing material — must never be committed
*.pfx
*.p12
*.cer
*.key

# Agent workspace data
.workbuddy-ai/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
