# Virtual environments and build output
.venv/
build/
dist/
release/
*.spec.bak

# Test artefacts (the suite is configured to keep its temp data local)
.pytest-tmp/
.pytest_cache/
__pycache__/
*.py[cod]
.coverage
htmlcov/

